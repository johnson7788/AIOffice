{
  "name": "@genoffice/pdf",
  "productName": "GenOffice PDF",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "PDF viewer/annotator (web SaaS build): pdf.js render + pdf-lib edits",
  "scripts": {
    "dev": "vite --config vite.renderer.config.ts",
    "build": "vite --config vite.renderer.config.ts build",
    "preview": "vite --config vite.renderer.config.ts preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@genoffice/agent-core": "*",
    "@genoffice/ai-provider": "*",
    "@genoffice/i18n": "*",
    "@genoffice/ui": "*",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "author": "GenOffice"
}
