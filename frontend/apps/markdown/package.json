{
  "name": "@genoffice/markdown",
  "productName": "GenOffice Markdown",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Markdown editor (web SaaS build): TipTap over plain .md text blobs",
  "scripts": {
    "dev": "vite --config vite.renderer.config.ts",
    "build": "vite --config vite.renderer.config.ts build",
    "preview": "vite --config vite.renderer.config.ts preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@genoffice/agent-core": "*",
    "@genoffice/ai-provider": "*",
    "@genoffice/docx-engine": "*",
    "@genoffice/i18n": "*",
    "@genoffice/project-store": "*",
    "@genoffice/ui": "*",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-code-block": "3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-list": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extensions": "3.29.2",
    "@tiptap/markdown": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@tiptap/suggestion": "3.29.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "author": "GenOffice"
}
