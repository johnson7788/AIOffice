# Copy to .env before `docker compose up`. compose injects these into `backend`.

# --- LLM (server-side, one model for all tenants) ---
MODEL_PROVIDER=deepseek          # google|claude|openai|deepseek|ali|silicon|modelscope|doubao|vllm|ollama
MODEL_NAME=deepseek-chat
DEEPSEEK_API_KEY=                # provider key: <PROVIDER>_API_KEY (CLAUDE_API_KEY, OPENAI_API_KEY, ...)

# Optional vision model (image understanding); falls back to main model if unset.
# VISION_MODEL=
# VISION_API_KEY=
# VISION_API_BASE=

# --- Security (MUST override in prod) ---
JWT_SECRET=change-me-to-a-32-byte-random-secret

# --- Search proxy (self-hosted SearXNG; blank disables) ---
SEARXNG_URL=

# --- Quotas / limits (0 disables the guard) ---
# MAX_BLOB_MB=50
# MAX_DOCS_PER_ORG=500
# MAX_STORAGE_MB_PER_ORG=2048
# LOCK_TTL_SEC=120
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_SEC=60

# DATABASE_URL / S3_* are set by docker-compose (postgres + minio). Override for
# managed PG / S3 in k8s or a hosted deploy.
