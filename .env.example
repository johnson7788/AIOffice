# =============================================================
# AI Office 后端环境变量示例
# 用法：复制本文件为 .env（docker compose 会把 .env 注入 backend 服务）
#   cp .env.example .env && vi .env
# 所有可选变量未设置时使用代码内默认值，本地开发开箱即用。
# =============================================================

# ---------- LLM 主模型（服务端统一，所有租户共用一套） ----------
# 模型服务商，可选值见下方「支持的服务商」清单。
MODEL_PROVIDER=deepseek
# 模型名（需与所选服务商接口兼容，如 deepseek-chat / gpt-4o / glm-4-plus）
MODEL_NAME=deepseek-chat
# 服务商密钥：填 <PROVIDER>_API_KEY（即下方清单里各家对应的变量名）
DEEPSEEK_API_KEY=

# --- 支持的服务商（MODEL_PROVIDER 可选值） ---
#   google     Google Gemini                GOOGLE_API_KEY         模型如 gemini-2.0-flash
#   claude     Anthropic Claude             CLAUDE_API_KEY         模型如 claude-sonnet-4-6
#   openai     OpenAI                       OPENAI_API_KEY         模型如 gpt-4o（默认 api.openai.com/v1）
#   deepseek   DeepSeek                     DEEPSEEK_API_KEY       模型如 deepseek-chat / deepseek-reasoner
#   ali        阿里云百炼（通义千问）        ALI_API_KEY             模型如 qwen-plus / qwen-max
#   silicon    硅基流动 SiliconFlow         SILICON_API_KEY        模型如 Qwen/Qwen2.5-7B-Instruct
#   modelscope 魔搭 ModelScope               MODELSCOPE_API_KEY     模型如 Qwen/Qwen2.5-7B-Instruct
#   doubao     火山方舟（豆包）              DOUBAO_API_KEY         模型如 doubao-seed-1-6-250615
#   zhipu      智谱 AI（GLM）                ZHIPUAI_API_KEY        模型如 glm-4-plus
#   moonshot   月之暗面（Kimi）              MOONSHOT_API_KEY       模型如 moonshot-v1-8k
#   xai        xAI（Grok）                   XAI_API_KEY            模型如 grok-2
#   groq       Groq                         GROQ_API_KEY           模型如 llama-3.3-70b-versatile
#   openrouter OpenRouter                   OPENROUTER_API_KEY     模型如 openai/gpt-4o
#   vllm       自建 vLLM（OpenAI 兼容）      VLLM_API_KEY + VLLM_API_BASE   模型如 Qwen/Qwen2.5-7B-Instruct
#   ollama     本地 Ollama（OpenAI 兼容）    OLLAMA_API_KEY + OLLAMA_API_BASE 模型如 llama3.1

# --- 自定义 API 地址（可选，<PROVIDER>_API_BASE） ---
# 默认走各家官方端点；走代理 / 内网 / 自建 OpenAI 兼容网关时，用对应变量的
# _API_BASE 覆盖，例如：
# DEEPSEEK_API_BASE=http://127.0.0.1:8000/v1
# OPENAI_API_BASE=https://my-proxy.example.com/v1

# ---------- 视觉模型（图片理解 / OCR，可选） ----------
# 主模型本身支持图片时可不配置。配置后，带图片的对话请求自动切换到该模型。
# VISION_MODEL 是完整 litellm 模型串，可带服务商前缀（如 openai/qwen-vl-max）。
# VISION_MODEL=openai/qwen-vl-max
# VISION_API_KEY=
# VISION_API_BASE=

# ---------- 安全（生产环境必须修改） ----------
JWT_SECRET=change-me-to-a-32-byte-random-secret
# JWT_TTL_MIN=1440                       # 登录态有效期（分钟，默认 24h）

# ---------- 数据库 / 对象存储（docker compose 自动注入，一般无需改） ----------
# 本地默认 SQLite + 本地磁盘，零配置即可运行。
# 生产使用 Postgres + MinIO/S3 时设置（compose 已注入，k8s/托管部署时覆盖）：
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/aioffice
# STORAGE_DIR=./storage                  # 本地磁盘存储目录
# S3_ENDPOINT=http://minio:9000          # 设置后改用 S3/MinIO 存储
# S3_BUCKET=aioffice
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# ---------- 搜索代理（自建 SearXNG，留空则禁用搜索） ----------
SEARXNG_URL=

# ---------- 配额 / 限流（0 表示关闭对应检查） ----------
# MAX_BLOB_MB=50                         # 单文档最大体积（MB）
# MAX_DOCS_PER_ORG=500                   # 每组织文档数量上限
# MAX_STORAGE_MB_PER_ORG=2048            # 每组织存储空间上限（MB）
# LOCK_TTL_SEC=120                       # 文档写锁 TTL（秒）
# RATE_LIMIT_MAX=300                     # 每个身份每窗口最大请求数
# RATE_LIMIT_WINDOW_SEC=60               # 限流窗口（秒）

# ---------- 表格引擎（xlsx sidecar，一般无需改） ----------
# XLSX_SIDECAR_BIN=/path/to/xlsx-sidecar # Rust 侧车二进制路径（默认取 backend/xlsx-engine 构建产物）
